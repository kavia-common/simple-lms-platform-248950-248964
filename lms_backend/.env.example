# Backend environment variables (do not commit real secrets)
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Path to SQLite DB file created by the lms_database container.
# This should point to the myapp.db file.
SQLITE_DB_PATH=/path/to/lms_database/myapp.db

# CORS
CORS_ALLOW_ORIGINS=*
